# ── Warehouse Leadership Excellence Assessment (WLEA) — environment ──
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# All four are read directly by name in code — the names must match exactly or
# the failure is silent (see note on the service key below).

# Supabase project (shared VSCE project). Browser + server clients.
#   used by: lib/supabase/client.ts, lib/supabase/server.ts
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Supabase service-role (secret) key. Server-side only — NEVER expose to the browser.
# Writes the anonymised benchmark seed, which is RLS-locked to the service role.
#   used by: lib/supabase/service.ts (via app/actions.ts)
# NOTE: the Layer-2 benchmark insert is intentionally non-fatal. If this key is
# missing or misnamed, assessments still work but NO benchmark data is captured,
# with no visible error. Set it correctly or you silently lose the flywheel data.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Resend — emails the completed report to the user (app/api/email-results/route.ts).
# If unset, the "Email me this report" action returns a clean error; the on-screen
# report is unaffected.
RESEND_API_KEY=YOUR-RESEND-API-KEY
